# AgentFlow admin token; change this before exposing the admin API.
ADMIN_TOKEN=change-me

# QQ Open Platform bot credentials.
QQ_APP_ID=your_qq_app_id
QQ_APP_SECRET=your_qq_app_secret

# Chat model (Anthropic-compatible endpoint used by this deployment).
MODEL_API_KEY=your_model_api_key

# Doubao web-search API key (builtin:web_search default engine).
DOUBAO_KEY=your_doubao_api_key
