# AgentFlow admin token; change this before exposing the admin API.
ADMIN_TOKEN=change-me

# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Chat model (Anthropic-compatible endpoint used by this deployment).
MODEL_API_KEY=your_model_api_key

# Embedding model: BAAI/bge-m3 on SiliconFlow (1024 dims).
BGE_KEY=your_siliconflow_api_key

# Web search engines: Google grounded search (Gemini API key) & X search (xAI API key).
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key

# Cloudflare Browser Rendering credentials for builtin:browser.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
