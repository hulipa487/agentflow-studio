{
  "name": "agentflow-studio-web",
  "private": true,
  "version": "0.1.0",
  "description": "AgentFlow Studio in the browser: build, run and trace agents on your own runtime.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
